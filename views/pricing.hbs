
<main class="pricing-page">
    <div class="container">
        <div class="pricing-header">
            <span class="badge">Cost</span>
            <h2>Choose your learning format</h2>
            <p>Prices are in Euros (€) for your convenience. Start your path to success today!</p>
        </div>

        <div class="pricing-grid">
            <div class="price-card">
                <h3>Start</h3>
                <div class="price">€45<span>/mo</span></div>
                <ul class="features">
                    <li>1 lesson per week</li>
                    <li>Homework assignments</li>
                    <li>Group up to 8 people</li>
                    <li>Platform access</li>
                </ul>
                <button class="btn btn-secondary">Select Plan</button>
            </div>

            <div class="price-card popular">
                <div class="popular-badge">Parents' Choice</div>
                <h3>Optima</h3>
                <div class="price">€79<span>/mo</span></div>
                <ul class="features">
                    <li>2 lessons per week</li>
                    <li>Student dashboard</li>
                    <li>Weekly reports</li>
                    <li>Priority support</li>
                </ul>
                <button class="btn btn-primary">Select Plan</button>
            </div>

            <div class="price-card">
                <h3>VIP</h3>
                <div class="price">€149<span>/mo</span></div>
                <ul class="features">
                    <li>Individual schedule</li>
                    <li>Personal mentor</li>
                    <li>Advanced program</li>
                    <li>Competition prep</li>
                </ul>
                <button class="btn btn-secondary">Select Plan</button>
            </div>
        </div>
    </div>
</main>